# Copy to .env.local for local development. Never commit real values.
# All VITE_* values end up in the public JavaScript bundle: only put public identifiers here.

# Web3Forms public access key (https://web3forms.com, created with the owner's email). Public by design.
VITE_WEB3FORMS_KEY=

# Canonical site URL. On Amplify the branch URL is derived automatically; set once a custom domain exists.
SITE_URL=
