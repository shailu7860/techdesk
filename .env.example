# Copy to .env.local for local development. Never commit real values.
# All VITE_* values end up in the public JavaScript bundle: only put public identifiers here.

# Web3Forms public access key (https://web3forms.com, created with the owner's email). Public by design.
VITE_WEB3FORMS_KEY=

# Chat endpoint. On Amplify it is read automatically from amplify_outputs.json; set only to override locally.
VITE_CHAT_URL=

# Canonical site URL. On Amplify the branch URL is derived automatically; set once a custom domain exists.
SITE_URL=

# Server-side only (never VITE_*): set with `npx ampx sandbox secret set GROQ_API_KEY` or in
# Amplify console → Hosting → Secrets. The chat function reads them at runtime.
# GROQ_API_KEY
# ANTHROPIC_API_KEY
