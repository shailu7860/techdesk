{
  "name": "techdesk",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/csp.mjs",
    "start": "node scripts/serve.mjs",
    "typecheck": "react-router typegen && tsc",
    "check:contrast": "node scripts/check-contrast.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "verify": "npm run lint && npm run typecheck && npm run check:contrast && npm run build && npm run seo:audit",
    "preview": "npm run build && node scripts/serve.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seo:audit": "node scripts/seo-audit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@react-router/node": "^8.4.0",
    "gsap": "^3.15.0",
    "isbot": "^5.2.2",
    "lenis": "^1.3.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "lodash": "^4.18.1"
  }
}
